{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "approval_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "payload_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "approval_id",
    "tool",
    "payload_fingerprint"
  ]
}
