{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "task_id": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "task_notes",
          "recent_validation",
          "related_pr"
        ]
      }
    },
    "project": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "agent",
    "prompt",
    "project"
  ]
}
