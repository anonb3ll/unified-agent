{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "doing",
        "waiting_review",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "priority": {
      "default": "med",
      "type": "string",
      "enum": [
        "high",
        "med",
        "low"
      ]
    },
    "urgency": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "now",
            "next",
            "later"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "urgency_rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "parent_id": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "project": {
      "default": "unified-agent",
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "lane": {
      "type": [
        "string",
        "null"
      ]
    },
    "due_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_host": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimed_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "lock_expires_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "verified_caller": {
      "type": "string"
    },
    "worktree_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "waiting_on": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminal_predicate": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownership_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "archived_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "untrusted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "waiting_for_review": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "laptop_lane": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    },
    "notes_archived": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "created_at",
    "updated_at"
  ]
}
