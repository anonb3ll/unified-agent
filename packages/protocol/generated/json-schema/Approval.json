{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "requested_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied",
        "consumed",
        "revoked",
        "expired"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "resolved_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_in_hours": {
      "type": [
        "number",
        "null"
      ]
    },
    "expired": {
      "type": "boolean"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "tool",
    "status",
    "created_at",
    "updated_at"
  ]
}
