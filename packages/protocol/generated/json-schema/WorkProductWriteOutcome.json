{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "approval_id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "work_product_id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "approval_id",
        "work_product_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "producing_agent": {
          "type": "string",
          "minLength": 1
        },
        "producing_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "template_pack": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "submitted",
            "approved",
            "rejected",
            "released",
            "tampered"
          ]
        },
        "previous_version_id": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "released_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "released_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reject_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "submitted_by": {
          "type": "string",
          "minLength": 1
        },
        "resolved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "released_at": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "content_sha256",
        "source_path",
        "size_bytes",
        "mime_type",
        "producing_agent",
        "producing_model",
        "template_pack",
        "tags",
        "status",
        "previous_version_id",
        "approval_id",
        "released_path",
        "released_sha256",
        "reject_reason",
        "submitted_by",
        "resolved_by",
        "resolved_at",
        "released_at",
        "created_at",
        "updated_at"
      ]
    }
  ]
}
