{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "source_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "template_pack": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tags": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "source_path",
    "title",
    "template_pack"
  ],
  "additionalProperties": false
}
