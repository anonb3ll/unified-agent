{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "default": "med",
      "type": "string",
      "enum": [
        "high",
        "med",
        "low"
      ]
    },
    "parent_id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "due_at": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ref": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
