{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "doing",
        "waiting_review",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "notes": {
      "type": "string"
    },
    "append_note": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "med",
        "low"
      ]
    },
    "parent_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "worktree": {
      "type": "boolean"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "expected_project": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "due_at": {
      "type": "string",
      "minLength": 1
    },
    "clear_due_at": {
      "type": "boolean"
    },
    "evidence_ref": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false
}
