{
  "name": "@unified-agent/protocol",
  "version": "0.2.1",
  "description": "Canonical cross-language Unified Agent protocol schemas (Zod → JSON Schema → Pydantic)",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "generated",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "export:json-schema": "tsx scripts/export-json-schema.ts",
    "generate:pydantic": "bash scripts/generate-pydantic.sh",
    "codegen": "npm run export:json-schema && npm run generate:pydantic",
    "codegen:check": "npm run codegen && node scripts/check-codegen-clean.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
