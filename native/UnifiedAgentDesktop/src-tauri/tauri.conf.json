{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unified Agent",
  "mainBinaryName": "unified-agent-desktop",
  "identifier": "dev.unifiedagent.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Unified Agent control center"
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["unified-agent"] }
    }
  }
}
