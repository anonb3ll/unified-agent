[Unit]
Description=unified-agent Zulip evening work handoff
After=network-online.target unified-agent.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/dev/unified_agent
Environment=UA_WORKSPACE=%h/dev/agent
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-%h/.unified_agent/service.env
ExecStart=%h/dev/unified_agent/.venv/bin/unified-agent-zulip-automation evening

