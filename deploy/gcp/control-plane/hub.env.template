# unified-agent cloud control plane — environment template (task #2148).
#
# The GCP equivalent of the Railway service variables in .railway/railway.ts:
# the same env contract, set on the host instead of the Railway dashboard.
# Copy this file OUTSIDE the repository, fill it in, and `chmod 600` it:
#
#   install -m 600 deploy/gcp/control-plane/hub.env.template ~/.config/unified-agent/gcp-hub.env
#
# Format: docker --env-file. One KEY=VALUE per line, no quotes (docker keeps
# them literally), no `export`, no spaces around `=`. Lines starting with #
# are ignored. An empty value is dropped by install.sh, so leave a key empty
# to mean "unset".
#
# Secret values come from a file you own or from Secret Manager. To use
# Secret Manager, write the reference instead of the value:
#
#   WORKOS_API_KEY=secretmanager:<secret-id>            # latest version
#   WORKOS_API_KEY=secretmanager:<secret-id>:<version>
#
# install.sh resolves references on the VM with the VM's service account
# (it needs roles/secretmanager.secretAccessor on that secret, an IAM grant
# that is the owner's step) and writes the resolved file with mode 0600. No
# value is ever printed; the scripts log key names only.
#
# Do NOT set these here. The systemd unit pins them and install.sh refuses an
# env file that tries to change them:
#   UA_HOSTED=1                    hosted start: platform values win, no token printed
#   UA_EXECUTION_LOCALITY=devices  the hub coordinates, devices execute (#2109)
#   UA_STATE_MOUNT_PATH=/data      start refused unless /data is the mounted data disk
#   UA_HOME, UA_ALLOW_EPHEMERAL_STATE, UA_ALLOW_ROOT, UA_DOCKER_ALLOW_INSECURE,
#   PORT, RAILWAY_*
# UA_PUBLIC_URL and UA_PUBLIC_HOSTS default to the VM's Tailscale Serve name;
# set them here only to override that.

# --- Identity (sealed on Railway) -------------------------------------------
# <operator label>:<token>,<agent label>:<token>,...  Generate each token with
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Leave empty to let the first boot generate tokens into /data/service.env
# (mode 0600 on the data disk; never logged).
UA_AGENT_TOKENS=
UA_OPERATOR_LABEL=
UA_OPERATOR_NAME=

# --- Edition and WorkOS sign-in (docs/deploy/railway.md, "Public ingress") ---
# The image already defaults to enterprise (Dockerfile ENV).
UA_EDITION=
UA_HUB_WORKOS_ORGANIZATION_ID=
UA_HUB_WORKOS_IDENTITY_MAP=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_ISSUER=
# https://<vm>.<tailnet>.ts.net/oauth/approver/workos/callback
WORKOS_REDIRECT_URI=
WORKOS_ORGANIZATION_ID=

# --- Remote MCP OAuth --------------------------------------------------------
UA_MCP_OAUTH=
# https://<vm>.<tailnet>.ts.net
UA_MCP_OAUTH_ISSUER=

# --- Optional overrides ------------------------------------------------------
UA_PUBLIC_URL=
UA_PUBLIC_HOSTS=
UA_APPROVAL_PUSH_URL=
UA_APPROVAL_PUSH_TOKEN=
UA_APPROVAL_WEBHOOK_URL=
UA_APPROVAL_WEBHOOK_SECRET=
