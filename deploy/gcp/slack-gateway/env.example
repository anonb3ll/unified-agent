# ua-slack-gateway — environment template (redacted)
#
# Copy to a host-local path (e.g. `/etc/ua-slack-gateway.env`) with mode 0600.
# Never commit a filled copy. Never paste real values into git, vault, tasks,
# or chat.

# Slack app Signing Secret (the operator places the real value)
SLACK_SIGNING_SECRET=

# Full Mac hub events URL over Tailscale (must end with /api/slack/events)
# Example shape only — replace the MagicDNS name and port with the live Mac hub:
# MAC_HUB_URL=http://<tailnet-host>.ts.net:8765/api/slack/events
MAC_HUB_URL=

# Loopback bind — TLS terminator proxies here
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8787

# Hub forward timeout (seconds)
FORWARD_TIMEOUT_S=25
