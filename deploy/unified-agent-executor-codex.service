# Active Executor Daemon — Codex backend (systemd user unit, task #196)
#
# A SECOND executor instance, alongside unified-agent-executor.service. The two
# do not collide: each polls delegate_list filtered by its own agent label, so
# Desktop_agent3 picks up only delegations addressed to Desktop_agent3 and this one
# only those addressed to Desktop_Agent2.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/unified-agent-executor-codex.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now unified-agent-executor-codex
#
# Logs:   journalctl --user -u unified-agent-executor-codex -f
# Verify: the startup line reads "executor starting: agent=Desktop_Agent2 backend=codex"
#
# Prerequisites:
#   1. `codex` on PATH and authenticated with ChatGPT subscription auth
#      (`codex login`). No API key is used or required.
#   2. A Desktop_Agent2 bearer token the hub knows, in the EnvironmentFile below
#      as UA_EXECUTOR_TOKEN. Without it the daemon refuses to start rather than
#      running outside the hub's auth/approval boundary.
#   3. Desktop_Agent2 present in the hub's UA_AGENT_LABELS (it is in the shipped
#      default set as of task #196, so this is only needed if you override it).

[Unit]
Description=unified-agent Active Executor Daemon (Codex backend)
After=unified-agent.service network-online.target
Wants=unified-agent.service network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/agent
# Explicit override, not just relying on config.py's DEFAULT_WORKSPACE — task
# #369: this unit silently ran from the wrong directory for days because it
# had no override and the default drifted stale during the #331 migration.
Environment=UA_WORKSPACE=%h/dev/agent
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=UA_EXECUTOR_AGENT=Desktop_Agent2
Environment=UA_EXECUTOR_BACKEND=codex
Environment=UA_EXECUTOR_SHADOW_MODE=0
# Desktop_Agent2 is a remote primary client after the Mac cutover. Set the full
# canonical /mcp URL in codex-executor.env; this unit intentionally has no
# loopback fallback. Server-local executors use deploy/mac-hub launchers.
Environment=UA_CODEX_MODEL=gpt-6-luna
# Stated explicitly even though it is the default, so the sandbox posture of
# this unit is visible in `systemctl --user cat` and not just implied.
#
# Raising this to danger-full-access ALSO requires UA_CODEX_ALLOW_FULL_ACCESS=1
# in the EnvironmentFile; the daemon refuses to start on the posture alone. It
# is tempting because Codex 0.145.0 auto-cancels MCP tool calls under
# workspace-write — but the executor does not need Codex to call MCP tools at
# all. The daemon performs every task/journal/memory write itself over its own
# authenticated hub client, so the child agent only has to edit files.
Environment=UA_CODEX_SANDBOX=workspace-write
# Load UA_EXECUTOR_TOKEN (Desktop_Agent2's hub bearer token) from a secure file
# (chmod 600). Kept separate from the agy executor's env file so the two agents
# do not share a credential.
EnvironmentFile=-%h/.config/unified-agent/codex-executor.env
ExecStart=%h/dev/unified_agent/.venv/bin/unified-agent-executor
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
