#!/usr/bin/env bash
# Launch the GitHub Copilot CLI with this agent's unified-agent hub server.
# Generated by unified-agent-distro. Holds no secrets and never prints a token.
#
# The Copilot CLI does not read .vscode/mcp.json (that file is for Copilot in
# VS Code), and its documentation does not say that it expands environment
# variables in --additional-mcp-config headers. So the server config is built
# here and handed over through bash process substitution:
#   --additional-mcp-config @/dev/fd/N
# The token never touches disk, nothing is left behind if the process is
# killed, and the config is never placed in argv (only the /dev/fd path is)
# or in Copilot's environment. `exec` replaces this shell with Copilot, so
# signals reach Copilot directly.
#
# Token source (UA_COPILOT_TOKEN_SOURCE):
#   file (default)  this agent's token file, UA_COPILOT_TOKEN_FILE. If it is
#                   missing or empty the wrapper stops: it never falls back to
#                   a token inherited from the parent shell, which may belong
#                   to another agent.
#   env             UA_AGENT_BEARER_TOKEN from the environment, only when you
#                   select it explicitly.
#
# The hub URL is the one baked in when this file was generated. To point
# elsewhere on purpose, set UA_DISTRO_HUB_URL_OVERRIDE to a plain http(s) URL
# with a host (no user:password@, query or fragment).
set -euo pipefail

# UA_TOKEN and config_json hold the bearer. If the parent shell exported
# variables with these names, assigning to them would keep the export
# attribute and hand the bearer to Copilot, so drop them first: they are then
# plain shell variables for the rest of this script.
unset UA_TOKEN config_json

me="ua-copilot"
HUB_URL="{{hub_url}}"
TOKEN_FILE="${UA_COPILOT_TOKEN_FILE:-$HOME/.copilot/unified-agent-token}"
TOKEN_SOURCE="${UA_COPILOT_TOKEN_SOURCE:-file}"
COPILOT_BIN="${COPILOT_BIN:-copilot}"

# A plain http(s) URL whose authority is a well-formed host and optional port:
# no '@' (userinfo), '?' (query), '#' (fragment), quotes, spaces or '$'. The
# host is a DNS-style name, a dotted-quad IPv4 address or a bracketed IPv6
# address; a port, when present, is 1-65535.
valid_ipv4() {
  local ip="$1" octet
  local -a parts
  [[ "$ip" =~ ^(0|[1-9][0-9]{0,2})(\.(0|[1-9][0-9]{0,2})){3}$ ]] || return 1
  IFS=. read -r -a parts <<< "$ip"
  for octet in "${parts[@]}"; do
    (( 10#$octet <= 255 )) || return 1
  done
}

valid_ipv6() {
  local ip="$1" head tail g i n=0 last compress=0
  local -a hg=() tg=() all=()
  [[ "$ip" =~ ^[0-9A-Fa-f:.]+$ && "$ip" == *:* && "$ip" != *:::* ]] || return 1
  if [[ "$ip" == *::* ]]; then
    compress=1
    head="${ip%%::*}"
    tail="${ip#*::}"
    [[ "$tail" != *::* && "$head" != :* && "$tail" != :* && "$tail" != *: ]] || return 1
    if [[ -n "$head" ]]; then IFS=: read -r -a hg <<< "$head"; fi
    if [[ -n "$tail" ]]; then IFS=: read -r -a tg <<< "$tail"; fi
  else
    [[ "$ip" != :* && "$ip" != *: ]] || return 1
    IFS=: read -r -a hg <<< "$ip"
  fi
  all=(${hg[@]+"${hg[@]}"} ${tg[@]+"${tg[@]}"})
  last=$(( ${#all[@]} - 1 ))
  for i in "${!all[@]}"; do
    g="${all[$i]}"
    if [[ "$g" =~ ^[0-9A-Fa-f]{1,4}$ ]]; then
      n=$(( n + 1 ))
    elif (( i == last )) && [[ "$g" == *.* ]] && (( ! compress || ${#tg[@]} > 0 )) && valid_ipv4 "$g"; then
      n=$(( n + 2 ))  # an embedded IPv4 tail is two groups
    else
      return 1
    fi
  done
  if (( compress )); then (( n <= 7 )); else (( n == 8 )); fi
}

valid_url() {
  local url="$1" rest hostport host port="" after
  local re='^https?://[]A-Za-z0-9._~:/+,;=%[-]+$'
  [[ "$url" =~ $re ]] || return 1
  rest="${url#*://}"
  hostport="${rest%%/*}"
  if [[ "$hostport" == \[* ]]; then
    # IPv6 literal: needs its closing ']', then nothing or ':<port>'.
    [[ "$hostport" == *\]* ]] || return 1
    host="${hostport#\[}"
    host="${host%%\]*}"
    after="${hostport#*\]}"
    if [[ -n "$after" ]]; then
      [[ "$after" =~ ^:[0-9]{1,5}$ ]] || return 1
      port="${after#:}"
    fi
    valid_ipv6 "$host" || return 1
  else
    [[ "$hostport" != *[\[\]]* ]] || return 1
    host="${hostport%%:*}"
    if [[ "$hostport" == *:* ]]; then
      port="${hostport#*:}"
      [[ "$port" =~ ^[0-9]{1,5}$ ]] || return 1
    fi
    [[ "$host" =~ ^[A-Za-z0-9._~-]+$ && "$host" != .* && "$host" != *..* ]] || return 1
    # An all-numeric host is an IPv4 address and must be a valid one.
    if [[ "$host" =~ ^[0-9.]+$ ]]; then valid_ipv4 "$host" || return 1; fi
  fi
  [[ -z "$port" ]] || (( 10#$port >= 1 && 10#$port <= 65535 ))
}

if [[ -n "${UA_DISTRO_HUB_URL_OVERRIDE:-}" ]]; then
  if ! valid_url "$UA_DISTRO_HUB_URL_OVERRIDE"; then
    echo "$me: UA_DISTRO_HUB_URL_OVERRIDE must be a plain http(s) URL with a host and no credentials, query or fragment" >&2
    exit 1
  fi
  HUB_URL="$UA_DISTRO_HUB_URL_OVERRIDE"
fi
if ! valid_url "$HUB_URL"; then
  echo "$me: the baked hub URL is not a plain http(s) URL; re-run unified-agent-distro init" >&2
  exit 1
fi

case "$TOKEN_SOURCE" in
  file)
    if [[ ! -r "$TOKEN_FILE" ]]; then
      echo "$me: token file is missing or unreadable: $TOKEN_FILE" >&2
      echo "$me: create it, point UA_COPILOT_TOKEN_FILE at it, or set UA_COPILOT_TOKEN_SOURCE=env to use UA_AGENT_BEARER_TOKEN" >&2
      exit 1
    fi
    UA_TOKEN="$(tr -d '\r\n' < "$TOKEN_FILE")"
    if [[ -z "$UA_TOKEN" ]]; then
      echo "$me: token file is empty: $TOKEN_FILE" >&2
      exit 1
    fi
    ;;
  env)
    UA_TOKEN="${UA_AGENT_BEARER_TOKEN:-}"
    if [[ -z "$UA_TOKEN" ]]; then
      echo "$me: UA_COPILOT_TOKEN_SOURCE=env but UA_AGENT_BEARER_TOKEN is not set" >&2
      exit 1
    fi
    ;;
  *)
    echo "$me: UA_COPILOT_TOKEN_SOURCE must be 'file' or 'env'" >&2
    exit 1
    ;;
esac
# The token is placed in JSON below, so refuse anything that would need escaping.
if [[ ! "$UA_TOKEN" =~ ^[A-Za-z0-9._~+/=-]+$ ]]; then
  echo "$me: the token has characters a bearer token should not have; check its source" >&2
  exit 1
fi

config_json="$(printf '{"mcpServers":{"unified-agent":{"type":"http","url":"%s","headers":{"Authorization":"Bearer %s"},"tools":["*"]}}}' "$HUB_URL" "$UA_TOKEN")"

# The token is not exported: Copilot gets it only through the pipe below, so
# it is not in Copilot's environment or inherited by its tool subprocesses.
# Variables inherited under the token's other names are removed as well, and
# so is the token file's location: Copilot's tool subprocesses have no reason
# to be pointed at the bearer file.
unset UA_AGENT_BEARER_TOKEN UA_COPILOT_HUB_TOKEN UA_COPILOT_TOKEN_FILE UA_COPILOT_TOKEN_SOURCE
# Behaviour checked against Copilot CLI 1.0.90: it reads this pipe once at
# startup, parses the config into memory and keeps that parsed config for
# later MCP reloads, so `/mcp reload` retains the hub server without a second
# read of the pipe. Re-check this when upgrading Copilot, since the pipe cannot
# be re-read by a CLI that opens --additional-mcp-config again.
exec "$COPILOT_BIN" --additional-mcp-config "@"<(printf '%s' "$config_json") "$@"
