#!/usr/bin/env bash
# Register the unified-agent hub with Claude Code at user scope.
# Generated by unified-agent-distro. Holds no secrets and never prints a token:
# the token is read from UA_AGENT_BEARER_TOKEN, or from the file named by
# UA_CLAUDE_TOKEN_FILE, at the moment this script runs.
#
# The hub URL is the one baked in when this file was generated. Ambient
# variables such as UA_HTTP_HUB_URL do not change it, so the bearer is only
# ever registered against that hub. To point somewhere else on purpose, set
# UA_DISTRO_HUB_URL_OVERRIDE to a plain http(s) URL with a host (no
# user:password@, query or fragment).
#
# User scope on purpose: a project-scoped .mcp.json entry for the hub would
# take precedence over this registration and replace the authenticated
# connection.
set -euo pipefail

me="ua-register-claude"
HUB_URL="{{hub_url}}"
SERVER_NAME="unified-agent"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"

# A plain http(s) URL whose authority is a well-formed host and optional port:
# no '@' (userinfo), '?' (query), '#' (fragment), quotes, spaces or '$'. The
# host is a DNS-style name, a dotted-quad IPv4 address or a bracketed IPv6
# address; a port, when present, is 1-65535.
valid_ipv4() {
  local ip="$1" octet
  local -a parts
  [[ "$ip" =~ ^(0|[1-9][0-9]{0,2})(\.(0|[1-9][0-9]{0,2})){3}$ ]] || return 1
  IFS=. read -r -a parts <<< "$ip"
  for octet in "${parts[@]}"; do
    (( 10#$octet <= 255 )) || return 1
  done
}

valid_ipv6() {
  local ip="$1" head tail g i n=0 last compress=0
  local -a hg=() tg=() all=()
  [[ "$ip" =~ ^[0-9A-Fa-f:.]+$ && "$ip" == *:* && "$ip" != *:::* ]] || return 1
  if [[ "$ip" == *::* ]]; then
    compress=1
    head="${ip%%::*}"
    tail="${ip#*::}"
    [[ "$tail" != *::* && "$head" != :* && "$tail" != :* && "$tail" != *: ]] || return 1
    if [[ -n "$head" ]]; then IFS=: read -r -a hg <<< "$head"; fi
    if [[ -n "$tail" ]]; then IFS=: read -r -a tg <<< "$tail"; fi
  else
    [[ "$ip" != :* && "$ip" != *: ]] || return 1
    IFS=: read -r -a hg <<< "$ip"
  fi
  all=(${hg[@]+"${hg[@]}"} ${tg[@]+"${tg[@]}"})
  last=$(( ${#all[@]} - 1 ))
  for i in "${!all[@]}"; do
    g="${all[$i]}"
    if [[ "$g" =~ ^[0-9A-Fa-f]{1,4}$ ]]; then
      n=$(( n + 1 ))
    elif (( i == last )) && [[ "$g" == *.* ]] && (( ! compress || ${#tg[@]} > 0 )) && valid_ipv4 "$g"; then
      n=$(( n + 2 ))  # an embedded IPv4 tail is two groups
    else
      return 1
    fi
  done
  if (( compress )); then (( n <= 7 )); else (( n == 8 )); fi
}

valid_url() {
  local url="$1" rest hostport host port="" after
  local re='^https?://[]A-Za-z0-9._~:/+,;=%[-]+$'
  [[ "$url" =~ $re ]] || return 1
  rest="${url#*://}"
  hostport="${rest%%/*}"
  if [[ "$hostport" == \[* ]]; then
    # IPv6 literal: needs its closing ']', then nothing or ':<port>'.
    [[ "$hostport" == *\]* ]] || return 1
    host="${hostport#\[}"
    host="${host%%\]*}"
    after="${hostport#*\]}"
    if [[ -n "$after" ]]; then
      [[ "$after" =~ ^:[0-9]{1,5}$ ]] || return 1
      port="${after#:}"
    fi
    valid_ipv6 "$host" || return 1
  else
    [[ "$hostport" != *[\[\]]* ]] || return 1
    host="${hostport%%:*}"
    if [[ "$hostport" == *:* ]]; then
      port="${hostport#*:}"
      [[ "$port" =~ ^[0-9]{1,5}$ ]] || return 1
    fi
    [[ "$host" =~ ^[A-Za-z0-9._~-]+$ && "$host" != .* && "$host" != *..* ]] || return 1
    # An all-numeric host is an IPv4 address and must be a valid one.
    if [[ "$host" =~ ^[0-9.]+$ ]]; then valid_ipv4 "$host" || return 1; fi
  fi
  [[ -z "$port" ]] || (( 10#$port >= 1 && 10#$port <= 65535 ))
}

if [[ -n "${UA_DISTRO_HUB_URL_OVERRIDE:-}" ]]; then
  if ! valid_url "$UA_DISTRO_HUB_URL_OVERRIDE"; then
    echo "$me: UA_DISTRO_HUB_URL_OVERRIDE must be a plain http(s) URL with a host and no credentials, query or fragment" >&2
    exit 1
  fi
  HUB_URL="$UA_DISTRO_HUB_URL_OVERRIDE"
fi
if ! valid_url "$HUB_URL"; then
  echo "$me: the baked hub URL is not a plain http(s) URL; re-run unified-agent-distro init" >&2
  exit 1
fi

UA_TOKEN="${UA_AGENT_BEARER_TOKEN:-}"
if [[ -z "$UA_TOKEN" && -n "${UA_CLAUDE_TOKEN_FILE:-}" ]]; then
  if [[ ! -r "$UA_CLAUDE_TOKEN_FILE" ]]; then
    echo "$me: token file is unavailable: $UA_CLAUDE_TOKEN_FILE" >&2
    exit 1
  fi
  UA_TOKEN="$(tr -d '\r\n' < "$UA_CLAUDE_TOKEN_FILE")"
fi
if [[ -z "$UA_TOKEN" ]]; then
  echo "$me: set UA_AGENT_BEARER_TOKEN or UA_CLAUDE_TOKEN_FILE for this agent" >&2
  exit 1
fi

echo "$me: registering '$SERVER_NAME' at user scope for $HUB_URL"
echo "$me: if it is already registered, first run: $CLAUDE_BIN mcp remove --scope user $SERVER_NAME"
exec "$CLAUDE_BIN" mcp add --scope user --transport http "$SERVER_NAME" "$HUB_URL" \
  --header "Authorization: Bearer $UA_TOKEN"
