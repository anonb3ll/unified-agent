#!/usr/bin/env bash
# Launch OpenCode with this agent's unified-agent hub token.
# Generated by unified-agent-distro. Holds no secrets and never prints a token.
# opencode.json reads the token from {env:UA_AGENT_BEARER_TOKEN}; this wrapper
# sets it from this agent's own token file, so the child never inherits
# another agent's token from the parent shell.
set -euo pipefail

me="ua-opencode"
TOKEN_FILE="${UA_OC_TOKEN_FILE:-$HOME/.opencode/unified-agent-token}"
OPENCODE_BIN="${OPENCODE_BIN:-opencode}"

if [[ ! -r "$TOKEN_FILE" ]]; then
  echo "$me: token file is unavailable: $TOKEN_FILE (set UA_OC_TOKEN_FILE)" >&2
  exit 1
fi
UA_TOKEN="$(tr -d '\r\n' < "$TOKEN_FILE")"
if [[ -z "$UA_TOKEN" ]]; then
  echo "$me: token file is empty: $TOKEN_FILE" >&2
  exit 1
fi

export UA_AGENT_BEARER_TOKEN="$UA_TOKEN"
exec "$OPENCODE_BIN" "$@"
